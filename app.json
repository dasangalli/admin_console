{
  "expo": {
    "name": "AdminConsole",
    "slug": "livestreamingadminconsole",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "adminconsole",
    
    "splash": {
      "backgroundColor": "#121212",
      "resizeMode": "contain"
    },

    "android": {
      "package": "com.admin.console",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "splash": {
        "backgroundColor": "#121212"
      }
    },

    "extra": {
      "eas": {
        "projectId": "5880371e-2bc3-4c20-baf7-399ecebe67e3"
      }
    },

    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
